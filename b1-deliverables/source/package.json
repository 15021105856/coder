{
  "name": "physio-log",
  "version": "7.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "lint": "eslint .",
    "build:monitor": "vite build --mode monitor",
    "build:archive": "vite build --mode archive",
    "docx": "node scripts/gen-docx.mjs",
    "check": "node scripts/check.mjs",
    "gen-download": "node scripts/gen-download.mjs",
    "pack": "node scripts/pack.mjs",
    "build": "npm run test && npm run lint && npm run check && npm run build:monitor && npm run build:archive && npm run docx && npm run gen-download && npm run check:release && npm run pack",
    "inject": "node scripts/inject-data.mjs",
    "preview": "vite preview",
    "check:release": "node scripts/check.mjs --release",
    "test:update": "node scripts/verify-update.mjs",
    "test:browser": "npm run build:monitor && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.64.0",
    "@resvg/resvg-js": "^2.6.2",
    "docx": "^9.8.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.4"
  }
}
